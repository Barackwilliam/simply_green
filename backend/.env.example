# ---------------------------------------------------------------------------
# Copy this file to `.env` before running locally:
#
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows)
#
# Never commit the real `.env`. On Render these are set in the dashboard.
# ---------------------------------------------------------------------------

# --- Local development --------------------------------------------------
# DEBUG=True serves static files and media directly and shows real errors.
DEBUG=True
DJANGO_ENV=development
SECRET_KEY=local-development-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# Leave DATABASE_URL blank to use a local SQLite file — enough for working on
# the site. To point at Supabase instead:
#   Dashboard -> Project Settings -> Database -> Connection string
#   -> "Session pooler" (port 5432), then paste the whole URI here.
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

# --- File storage -------------------------------------------------------
# Off locally: uploads go to backend/mediafiles/ on disk.
USE_SUPABASE_STORAGE=False
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=media
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Email --------------------------------------------------------------
# The console backend prints emails to the terminal instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@simplygreen.or.tz
NOTIFICATION_RECIPIENTS=

# --- Production only ----------------------------------------------------
# Leave off locally. Render sets this to True.
SECURE_SSL_REDIRECT=False
