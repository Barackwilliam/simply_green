# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Never commit the real `.env`.
# On Render these are set as environment variables in the dashboard.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------
# Supabase: Dashboard -> Project Settings -> Database -> Connection string
# Use the "Session pooler" URI (port 5432) and keep sslmode=require.
# Leave blank to fall back to a local SQLite file.
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

# --- Supabase Storage (images, PDFs, audio) ---------------------------
# Generate S3 keys at: Dashboard -> Project Settings -> Storage -> S3 access keys
USE_SUPABASE_STORAGE=False
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=media
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Frontend ---------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email notifications ----------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@simplygreen.or.tz
# Comma-separated addresses that receive form submissions
NOTIFICATION_RECIPIENTS=

# --- Security (production only) ---------------------------------------
SECURE_SSL_REDIRECT=True
